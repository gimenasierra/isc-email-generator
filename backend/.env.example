# Las credenciales se administran desde “Conexiones ISC”.
# La aplicación crea claves internas con este formato y valores codificados en base64:
# ISC_CONNECTION_<ID>_CLIENT_ID_B64=
# ISC_CONNECTION_<ID>_CLIENT_SECRET_B64=

# Las claves de proveedores de IA pueden configurarse manualmente en texto o se
# guardan desde la interfaz en una variable equivalente terminada en _B64.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LOCAL_OPENAI_API_KEY=
# GEMINI_API_KEY_B64=
# GROQ_API_KEY_B64=
# ANTHROPIC_API_KEY_B64=
# OPENAI_API_KEY_B64=
# LOCAL_OPENAI_API_KEY_B64=
